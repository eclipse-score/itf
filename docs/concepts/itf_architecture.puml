@startuml ITF Architecture
!pragma layout smetana
skinparam componentStyle rectangle
skinparam defaultFontName sans-serif
skinparam linetype ortho

package "Test code and frontends" {
    component "pytest tests\ntarget.<role> / @itf.requires" as Tests
    component "pytest adapter\nfixtures and selection" as Pytest
    component "ITF CLI / Python API" as Frontends
    component "Bazel\nitf_target / py_itf_test" as Bazel
}

package "Declarations" {
    artifact "Target file\nroles, settings, goals, relations" as TargetFile
    component "Pack and project parts\nfactories, actions, probes\nconsumer Protocols" as Parts
}

package "ITF core" {
    component "Session\nresolve, bring_up, reach, renew, close" as Session
    component "Target handle\nrole access" as Handle
    component "Realization and execution\nconstruct lazily, probe, act, unwind" as Runtime
}

package "OCTO (standard library only)" {
    component "Planner\nbindings, shape checks, state ordering" as Planner
}

package "External resources" {
    component "Containers / VMs / hardware\nSSH / serial / observability" as Resources
}

Tests --> Pytest : runs through
Tests --> Handle : uses roles
Pytest --> Session : owns test-run lifecycle
Frontends --> Session : uses the same lifecycle API
Bazel --> TargetFile : compiles and supplies
Bazel --> Pytest : launches tests
TargetFile --> Session : selects parts and goals
Parts --> Session : publishes declarations
Session --> Planner : plans from metadata
Session --> Runtime : executes the plan
Handle --> Runtime : realizes requested roles
Runtime --> Parts : invokes factories, actions, probes\nand finalizers
Parts --> Resources : backend implementations\naccess resources at runtime

note bottom of Planner
  Offline planning constructs no resources
  and runs no actions or hardware probes.
end note
@enduml
