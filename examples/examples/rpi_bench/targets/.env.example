# Copy this file to .env beside rpi.itf.yaml and set your bench. git ignores .env; the environment wins over it.
PSU_ADDRESS=TCPIP::192.168.1.50::INSTR
PSU_CHANNEL=1
SD_MUX=sd-wire_11
RPI_IMAGE=/images/rpi-os-arm64.img
RPI_IP=192.168.1.42
RPI_USER=pi
RPI_SSH_KEY=/home/lab/.ssh/rpi_bench
BENCH_DLT_HOST_IP=192.168.1.10
RPI_DLT_MULTICAST=
RPI_DLT_RECEIVE=/opt/dlt/aarch64/dlt-receive
